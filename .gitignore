# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Ambiente e segredos
.env
.mcp.json
.claude/settings.local.json

# Viagens reais: dado pessoal, fica so no disco.
# Publicos: o exemplo preenchido e o modelo em branco para copiar.
viagens/*.json
!viagens/exemplo-*.json
!viagens/_modelo.json

# Backup de arquivo de viagem: mesmo dado pessoal do original.
# `viagens/*.json` nao pega `.json.bak`, entao precisa da linha propria.
*.bak
*.bak-*

# Roteiros gerados (saida do ferramentas/gerar.py)
roteiro-*.html
dados_roteiro.json

# Paginas de decisao de viagem real: mesmo motivo de viagens/*.json -
# tem destino, datas, orcamento e o que foi decidido.
decisoes-*.html
